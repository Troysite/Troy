<script>
let cur=0; const slides=document.querySelectorAll('.slide'); const dots=document.getElementById('dots');
slides.forEach((_,i)=>{let d=document.createElement('span');d.className='dot'+(i==0?' active':'');d.onclick=()=>show(i);dots.appendChild(d)});
function show(n){slides[cur].classList.remove('active');dots.children[cur].classList.remove('active');cur=n;slides[cur].classList.add('active');dots.children[cur].classList.add('active')}
setInterval(()=>{show((cur+1)%slides.length)},4000);
</script>
